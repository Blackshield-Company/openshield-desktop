{
  "name": "openshield-desktop",
  "version": "0.2.0",
  "description": "OpenShield Desktop — the GUI companion for the OpenShield AI coding harness. Part of the Blackshield Company.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
